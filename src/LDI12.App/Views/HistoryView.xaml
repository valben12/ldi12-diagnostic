<UserControl x:Class="LDI12.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LDI12.App">

    <UserControl.Resources>

        <!-- Un changement de constat : la même présentation que dans les écrans de domaine,
             pastille de gravité comprise, pour que le technicien retrouve ses repères. -->
        <DataTemplate x:Key="ChangeTemplate">
            <Grid Margin="0,0,0,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Style="{StaticResource SeverityDot}"
                         VerticalAlignment="Top" Margin="0,5,0,0" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource Text.Body}"
                                   Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding RuleId}" Style="{StaticResource Text.Muted}"
                                   VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Muted}"
                               Margin="0,4,0,0" TextWrapping="Wrap" FontStyle="Italic"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1440" Margin="28,30,28,36">

            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Icon}" Width="20" Height="20"
                      Data="{StaticResource Icon.History}"
                      Stroke="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                <TextBlock Text="Historique" Style="{StaticResource Text.Title}" Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Body}" Margin="0,8,0,18"
                       TextWrapping="Wrap" MaxWidth="1000" HorizontalAlignment="Left" />

            <!-- ===== Archivage =====
                 Ce que le geste engage est dit avant le bouton qui le déclenche : un diagnostic
                 archivé, ce sont des données du client qui restent sur la machine de l'atelier. -->
            <Border Style="{StaticResource Card}" Padding="20,18" local:Motion.Entrance="True">
                <StackPanel>
                    <TextBlock Text="ARCHIVER LE DIAGNOSTIC AFFICHÉ" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,7,0,0" MaxWidth="960"
                               HorizontalAlignment="Left" TextWrapping="Wrap"
                               Text="Un diagnostic archivé sert de point de comparaison après l'intervention : c'est lui qui permettra de montrer au client ce qui a changé. Il contient les numéros de série de la machine, les comptes Windows et les réseaux sans fil du logement, et il reste sur cet ordinateur jusqu'à ce que vous le supprimiez." />
                    <TextBlock Text="{Binding FolderSummary}" Style="{StaticResource Text.Muted}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding FolderPath}" Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                               Opacity="0.75" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource Button.Primary}" Content="Archiver ce diagnostic"
                                Command="{Binding ArchiveCommand}" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Ouvrir le dossier"
                                Command="{Binding OpenFolderCommand}" Margin="10,0,0,0" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Actualiser"
                                Command="{Binding RefreshCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Diagnostics archivés ===== -->
            <TextBlock Text="DIAGNOSTICS ARCHIVÉS" Style="{StaticResource Text.Eyebrow}" Margin="2,24,0,10"
                       Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}" />

            <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius.Card}" Padding="18,14">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{DynamicResource Brush.BorderStrong}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{DynamicResource Brush.BrandRed}" />
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource Brush.SurfaceHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Date}" Style="{StaticResource Text.Body}"
                                           Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Machine}" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Text="  ·  " Style="{StaticResource Text.Muted}" />
                                    <TextBlock Text="{Binding Mode}" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Text="  ·  " Style="{StaticResource Text.Muted}" />
                                    <TextBlock Text="{Binding Findings}" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Text="  ·  " Style="{StaticResource Text.Muted}" />
                                    <TextBlock Text="{Binding Size}" Style="{StaticResource Text.Muted}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Reference}" Style="{StaticResource Text.Muted}"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding Reference, Converter={StaticResource TextToVisibility}}" />
                                <TextBlock Text="{Binding Problem}" Style="{StaticResource Text.Muted}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.StatusWarning}"
                                           Visibility="{Binding Problem, Converter={StaticResource TextToVisibility}}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding Score}" Style="{StaticResource Text.Emphasis}"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Comparaison : un seul geste, l'archive choisie contre le diagnostic affiché. -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                        Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource Button.Primary}" Content="Comparer au diagnostic affiché"
                        Command="{Binding CompareCommand}"
                        Visibility="{Binding CanCompareNow, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource Button.Ghost}" Content="Supprimer ce diagnostic"
                        Command="{Binding RequestDeleteCommand}" Margin="10,0,0,0"
                        Visibility="{Binding IsConfirmingDelete, Converter={StaticResource HiddenWhenTrue}}" />
            </StackPanel>

            <TextBlock Text="{Binding CompareReason}" Style="{StaticResource Text.Muted}" Margin="2,8,0,0"
                       TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"
                       Visibility="{Binding CompareReason, Converter={StaticResource TextToVisibility}}" />

            <!-- ===== Confirmation de suppression =====
                 Le nom du fichier est sous les yeux au moment de confirmer : c'est la règle qui
                 vaut pour toute suppression dans ce logiciel. -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,12,0,0"
                    BorderBrush="{DynamicResource Brush.StatusWarning}"
                    Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="SUPPRIMER CE DIAGNOSTIC ARCHIVÉ" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{Binding Selected.Entry.FileName, StringFormat=Le fichier « {0} » sera supprimé définitivement.}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Il ne passe pas par la corbeille. Le diagnostic ne pourra plus servir de point de comparaison." />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Primary}" Content="Supprimer définitivement"
                                Command="{Binding ConfirmDeleteCommand}" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Annuler"
                                Command="{Binding AbandonDeleteCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Résultat de la comparaison ===== -->
            <StackPanel Visibility="{Binding HasComparison, Converter={StaticResource BoolToVisibility}}">

                <Grid Margin="2,28,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CE QUI A CHANGÉ" Style="{StaticResource Text.Eyebrow}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource Button.Ghost}"
                            Content="Exporter le comparatif" Command="{Binding ExportCommand}" />
                </Grid>

                <Border Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{Binding ScoreLine}" Style="{StaticResource Text.Emphasis}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SummaryLine}" Style="{StaticResource Text.Body}"
                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding IdentityLine}" Style="{StaticResource Text.Muted}"
                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Les réserves sont au-dessus du résultat, pas en bas de page : un score qui
                     monte parce que le second diagnostic a moins regardé n'est pas une réparation. -->
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,12,0,0"
                        BorderBrush="{DynamicResource Brush.StatusWarning}"
                        Visibility="{Binding HasCaveats, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Width="16" Height="16"
                                  Data="{StaticResource Icon.AlertTriangle}"
                                  Stroke="{DynamicResource Brush.StatusWarning}" VerticalAlignment="Center" />
                            <TextBlock Text="À LIRE AVANT DE CONCLURE" Style="{StaticResource Text.Eyebrow}"
                                       Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Caveats}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}"
                                               Margin="0,0,0,7" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="CONSTATS RÉGLÉS" Style="{StaticResource Text.Eyebrow}" Margin="2,22,0,10"
                           Visibility="{Binding Resolved.Count, Converter={StaticResource CountToVisibility}}" />
                <Border Style="{StaticResource Card}" Padding="20,16"
                        Visibility="{Binding Resolved.Count, Converter={StaticResource CountToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Resolved}" ItemTemplate="{StaticResource ChangeTemplate}" />
                </Border>

                <TextBlock Text="CONSTATS APPARUS DEPUIS" Style="{StaticResource Text.Eyebrow}" Margin="2,22,0,10"
                           Visibility="{Binding Appeared.Count, Converter={StaticResource CountToVisibility}}" />
                <Border Style="{StaticResource Card}" Padding="20,16"
                        Visibility="{Binding Appeared.Count, Converter={StaticResource CountToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Appeared}" ItemTemplate="{StaticResource ChangeTemplate}" />
                </Border>

                <TextBlock Text="NON REVÉRIFIÉS PAR LE SECOND DIAGNOSTIC" Style="{StaticResource Text.Eyebrow}"
                           Margin="2,22,0,10"
                           Visibility="{Binding NotRechecked.Count, Converter={StaticResource CountToVisibility}}" />
                <Border Style="{StaticResource Card}" Padding="20,16"
                        BorderBrush="{DynamicResource Brush.StatusWarning}"
                        Visibility="{Binding NotRechecked.Count, Converter={StaticResource CountToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="Ces constats n'apparaissent plus, mais le contrôle qui les produisait n'a pas conclu lors du second diagnostic. Ils ne sont pas réglés pour autant : une analyse complète les tranchera." />
                        <ItemsControl ItemsSource="{Binding NotRechecked}" ItemTemplate="{StaticResource ChangeTemplate}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="CONSTATS INCHANGÉS" Style="{StaticResource Text.Eyebrow}" Margin="2,22,0,10"
                           Visibility="{Binding Persisting.Count, Converter={StaticResource CountToVisibility}}" />
                <Border Style="{StaticResource Card}" Padding="20,16"
                        Visibility="{Binding Persisting.Count, Converter={StaticResource CountToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Persisting}" ItemTemplate="{StaticResource ChangeTemplate}" />
                </Border>

                <!-- ===== Mesures suivies ===== -->
                <TextBlock Text="MESURES SUIVIES" Style="{StaticResource Text.Eyebrow}" Margin="2,22,0,10"
                           Visibility="{Binding Measures.Count, Converter={StaticResource CountToVisibility}}" />
                <Border Style="{StaticResource Card}" Padding="20,16"
                        Visibility="{Binding Measures.Count, Converter={StaticResource CountToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Measures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Style="{StaticResource Text.Body}"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextWrapping="Wrap" Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Before}"
                                                   Style="{StaticResource Text.Muted}" MinWidth="90"
                                                   TextAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="  →  " Style="{StaticResource Text.Muted}" />
                                        <TextBlock Grid.Column="3" Text="{Binding After}"
                                                   Style="{StaticResource Text.Body}"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   MinWidth="90" TextAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{Binding Delta}"
                                                   Style="{StaticResource Text.Muted}" MinWidth="90"
                                                   TextAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Muted}"
                                               Margin="0,3,0,0" TextWrapping="Wrap" FontStyle="Italic"
                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
