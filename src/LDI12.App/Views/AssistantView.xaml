<UserControl x:Class="LDI12.App.Views.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LDI12.App">

    <UserControl.Resources>
        <DataTemplate x:Key="ChipTemplate">
            <ToggleButton Style="{StaticResource Chip}" Content="{Binding Text}" IsChecked="{Binding IsSelected}" />
        </DataTemplate>

        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>

        <Style x:Key="StageCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="26,24" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="local:Motion.Entrance" Value="True" />
        </Style>

        <!-- Les deux portes d'entrée : une grande tuile chacune. -->
        <Style x:Key="ModeTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="local:Motion.Lift" Value="True" />
            <Setter Property="local:Motion.Entrance" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Margin="0,0,12,12" Padding="24,22" MinHeight="168"
                                Background="{DynamicResource Brush.CardFill}"
                                BorderBrush="{DynamicResource Brush.CardEdge}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Card}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.BrandRed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- La pastille d'icône des tuiles, en dégradé de la marque. -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFF0444B" Offset="0" />
                        <GradientStop Color="#FFB4161D" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Constat : un trait de couleur à gauche selon sa gravité. -->
        <Style x:Key="FindingStripe" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,2,14,2" />
            <Setter Property="Background" Value="{DynamicResource Brush.StatusInfo}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource Brush.StatusWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Problem">
                    <Setter Property="Background" Value="{DynamicResource Brush.StatusProblem}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Critical">
                    <Setter Property="Background" Value="{DynamicResource Brush.StatusCritical}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepStatus" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="None">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Running">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Good">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.StatusGood}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Bad">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.StatusCritical}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" local:Motion.SmoothScroll="True">
            <StackPanel MaxWidth="1000" Margin="28,30,28,36">

                <ContentControl Style="{StaticResource PageHeader}" Tag="{StaticResource Icon.Sparkles}" Content="Assistant"
                                local:Motion.Entrance="True" />

                <!-- ===== La clé ===== -->
                <Border Style="{StaticResource StageCard}" Margin="0,22,0,0" MaxWidth="620" HorizontalAlignment="Left"
                        Visibility="{Binding IsKey, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Activer l'assistant" Style="{StaticResource Text.Title}" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,16" TextWrapping="Wrap"
                                   Text="Collez votre clé d'API (console Anthropic). Saisie une fois, elle reste chiffrée à côté du logiciel, et ne sert que sur ce support." />
                        <Border Background="{DynamicResource Brush.SurfaceHover}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Padding="4,2">
                            <PasswordBox x:Name="KeyBox" PasswordChanged="OnKeyChanged" Padding="6,7" MinHeight="34"
                                         FontFamily="Consolas" FontSize="13" VerticalContentAlignment="Center" BorderThickness="0"
                                         Background="Transparent" Foreground="{DynamicResource Brush.TextPrimary}"
                                         CaretBrush="{DynamicResource Brush.BrandRed}" SelectionBrush="{DynamicResource Brush.BrandRed}" />
                        </Border>
                        <TextBlock Text="{Binding KeyError}" Style="{StaticResource Text.Muted}" Foreground="{DynamicResource Brush.StatusCritical}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding KeyError, Converter={StaticResource TextToVisibility}}" />
                        <WrapPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource Button.Primary}" Content="Enregistrer" Command="{Binding SaveKeyCommand}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Obtenir une clé" Command="{Binding OpenConsoleCommand}" />
                        </WrapPanel>
                        <TextBlock Text="Vérification de la clé…" Style="{StaticResource Text.Muted}" Margin="0,10,0,0"
                                   Visibility="{Binding IsCheckingKey, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- ===== L'accueil : deux analyses ===== -->
                <StackPanel Margin="0,22,0,0" Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}">
                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource ModeTile}" Command="{Binding DriversCommand}">
                            <StackPanel>
                                <Border Style="{StaticResource Badge}">
                                    <Path Style="{StaticResource Icon}" Width="20" Height="20" Data="{StaticResource Icon.Cpu}" Stroke="White" />
                                </Border>
                                <TextBlock Text="Pilotes" Style="{StaticResource Text.Title}" Margin="0,16,0,6" />
                                <TextBlock Text="Chaque pilote comparé au matériel et aux versions du constructeur."
                                           Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ModeTile}" Command="{Binding GuideCommand}">
                            <StackPanel>
                                <Border Style="{StaticResource Badge}">
                                    <Path Style="{StaticResource Icon}" Width="20" Height="20" Data="{StaticResource Icon.Sparkles}" Stroke="White" />
                                </Border>
                                <TextBlock Text="Dépannage guidé" Style="{StaticResource Text.Title}" Margin="0,16,0,6" />
                                <TextBlock Text="Le domaine, ce que vous observez : la cause est cherchée et réglée, pas à pas s'il le faut."
                                           Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <DockPanel Margin="2,6,12,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Oublier la clé" Command="{Binding ForgetKeyCommand}" />
                        <TextBlock Text="{Binding KeyText}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>

                <!-- ===== Le dépannage guidé : le domaine, ce qu'on observe, aucune conversation ===== -->
                <Border Style="{StaticResource StageCard}" Margin="0,22,0,0"
                        Visibility="{Binding IsGuide, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="1. Où est le problème ?" Style="{StaticResource Text.Title}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Problems}" ItemsPanel="{StaticResource Wrap}"
                                      ItemTemplate="{StaticResource ChipTemplate}" Focusable="False" />
                        <TextBlock Text="2. Ce que vous observez" Style="{StaticResource Text.Title}" Margin="0,18,0,12" />
                        <ItemsControl ItemsSource="{Binding Details}" ItemsPanel="{StaticResource Wrap}"
                                      ItemTemplate="{StaticResource ChipTemplate}" Focusable="False" />
                        <TextBlock Text="3. Votre constat" Style="{StaticResource Text.Title}" Margin="0,18,0,12" />
                        <TextBox Style="{StaticResource Field}" Tag="Facultatif : « le pilote est installé, reconnu, mais aucun son ne sort »"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalContentAlignment="Top" />
                        <WrapPanel Margin="0,18,0,0">
                            <Button Style="{StaticResource Button.Primary}" Content="Lancer l'analyse" Command="{Binding StartGuidedCommand}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Retour" Command="{Binding BackCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Analyse en cours ===== -->
                <Border Style="{StaticResource StageCard}" Margin="0,22,0,0" Width="620" HorizontalAlignment="Left"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" Margin="0,0,14,0">
                                <Path Style="{StaticResource Icon}" Width="20" Height="20" Data="{StaticResource Icon.Sparkles}" Stroke="White"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="Pulse" />
                                    </Path.RenderTransform>
                                    <Path.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="ScaleX"
                                                                     From="0.85" To="1.08" Duration="0:0:0.9" />
                                                    <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="ScaleY"
                                                                     From="0.85" To="1.08" Duration="0:0:0.9" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Path.Triggers>
                                </Path>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Analyse en cours" Style="{StaticResource Text.Eyebrow}" />
                                <TextBlock Text="{Binding RunTitle}" Style="{StaticResource Text.Title}" />
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource Progress}" IsIndeterminate="True" Margin="0,18,0,14" />
                        <ItemsControl ItemsSource="{Binding Trace}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3" local:Motion.Entrance="True">
                                        <Grid DockPanel.Dock="Left" Width="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Path Data="M 0,4 L 3.5,7.5 L 10,0.5" Width="10" Height="8" Stretch="Uniform"
                                                  Stroke="{DynamicResource Brush.StatusGood}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
                                            <!-- En cours : un point qui respire. -->
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.BrandRed}"
                                                     Visibility="{Binding IsDone, Converter={StaticResource HiddenWhenTrue}}">
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Button.Ghost}" Content="Arrêter" Command="{Binding CancelCommand}"
                                HorizontalAlignment="Left" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>

                <!-- ===== Échec ===== -->
                <Border Style="{StaticResource StageCard}" Margin="0,22,0,0" Width="620" HorizontalAlignment="Left"
                        Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="L'analyse n'a pas abouti" Style="{StaticResource Text.Title}" />
                        <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Body}" Margin="0,8,0,16" TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Style="{StaticResource Button.Primary}" Content="Réessayer" Command="{Binding RetryCommand}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Revenir à l'étape" Command="{Binding ReturnToStepCommand}" Margin="0,0,10,0"
                                    Visibility="{Binding CanReturnToStep, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Retour" Command="{Binding BackCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Le dépannage réglé ===== -->
                <Border Style="{StaticResource StageCard}" Margin="0,22,0,0" Width="620" HorizontalAlignment="Left"
                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Margin="0,0,14,0"
                                    Background="{DynamicResource Brush.StatusGoodSoft}">
                                <Path Data="M 0,4 L 3.5,7.5 L 10,0.5" Width="18" Height="14" Stretch="Uniform"
                                      Stroke="{DynamicResource Brush.StatusGood}" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding RunTitle}" Style="{StaticResource Text.Eyebrow}" />
                                <TextBlock Text="{Binding ApplyText}" Style="{StaticResource Text.Title}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding CostText}" Style="{StaticResource Text.Muted}" Margin="0,14,0,16" TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Style="{StaticResource Button.Primary}" Content="Vérifier par un diagnostic" Command="{Binding VerifyCommand}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Nouveau dépannage" Command="{Binding BackCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ===== L'étape ===== -->
                <StackPanel Margin="0,22,0,0" Visibility="{Binding IsResult, Converter={StaticResource BoolToVisibility}}">

                    <!-- Les étapes passées, une ligne chacune. -->
                    <ItemsControl ItemsSource="{Binding History}" Focusable="False" Margin="0,0,0,8"
                                  Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4,0,0,8">
                                    <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Margin="0,6,12,0" VerticalAlignment="Top"
                                            Background="{DynamicResource Brush.TextTertiary}" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap">
                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding Summary, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Done}" Style="{StaticResource Text.Muted}" Foreground="{DynamicResource Brush.TextTertiary}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Ce qui est compris, et les causes envisagées. -->
                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" CornerRadius="11" Padding="10,3" VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.StatusInfoSoft}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKey}" Value="Resolved">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.StatusGoodSoft}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKey}" Value="OutOfReach">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.StatusWarningSoft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusKey}" Value="Resolved">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusGood}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKey}" Value="OutOfReach">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusWarning}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding RunTitle}" Style="{StaticResource Text.Title}" />
                            </DockPanel>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />

                            <!-- Les hypothèses : une barre de vraisemblance chacune ; écartée, elle s'efface. -->
                            <ItemsControl ItemsSource="{Binding Hypotheses}" Margin="0,16,0,0" Focusable="False"
                                          Visibility="{Binding HasHypotheses, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10" local:Motion.Entrance="True">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StateKey}" Value="Ruled">
                                                            <Setter Property="Opacity" Value="0.45" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Cause}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextPrimary}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Muted}" />
                                            </StackPanel>
                                            <ProgressBar Grid.Column="1" Style="{StaticResource Progress}" Height="6" Maximum="1" VerticalAlignment="Center"
                                                         local:Motion.Fill="{Binding Share, Mode=OneWay}" />
                                            <TextBlock Grid.Column="2" Text="{Binding LikelihoodText}" Style="{StaticResource Text.Muted}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Findings}" Margin="0,8,0,0" Focusable="False"
                                          Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,10" local:Motion.Entrance="True">
                                            <Border DockPanel.Dock="Left" Style="{StaticResource FindingStripe}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- À faire : chaque opération se lance de sa carte, chaque geste manuel se coche. -->
                    <TextBlock Text="À faire" Style="{StaticResource Text.Eyebrow}" Margin="4,8,0,10" />
                    <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,8" local:Motion.Entrance="True">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Button.Ghost}" Content="Lancer" Command="{Binding RunCommand}"
                                                    Visibility="{Binding IsAutomatic, Converter={StaticResource BoolToVisibility}}" />
                                            <CheckBox Content="Fait" IsChecked="{Binding IsChecked}" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource Brush.TextSecondary}"
                                                      Visibility="{Binding IsAutomatic, Converter={StaticResource HiddenWhenTrue}}" />
                                        </Grid>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding KindText}" Style="{StaticResource Text.Muted}"
                                                           Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"
                                                           TextWrapping="Wrap">
                                                    <Run Text="{Binding Number, Mode=OneWay}" Foreground="{DynamicResource Brush.TextTertiary}" /><Run Text=".  " Foreground="{DynamicResource Brush.TextTertiary}" /><Run Text="{Binding Title, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Why}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <Border Background="{DynamicResource Brush.SurfaceSoft}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0"
                                                    Visibility="{Binding HasManual, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Manual}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                            </Border>
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource StepStatus}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- À vérifier : une question, ses réponses en boutons. -->
                    <TextBlock Text="À vérifier" Style="{StaticResource Text.Eyebrow}" Margin="4,10,0,10"
                               Visibility="{Binding HasChecks, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Checks}" Focusable="False"
                                  Visibility="{Binding HasChecks, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,8" local:Motion.Entrance="True">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Question}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <ItemsControl ItemsSource="{Binding Answers}" ItemsPanel="{StaticResource Wrap}"
                                                      ItemTemplate="{StaticResource ChipTemplate}" Focusable="False" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBox Style="{StaticResource Field}" Margin="0,8,0,0" Tag="Ce que vous avez constaté de plus (facultatif)"
                             Text="{Binding StepNote, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsResolved, Converter={StaticResource HiddenWhenTrue}}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" VerticalContentAlignment="Top" />

                    <TextBlock Text="{Binding Next}" Style="{StaticResource Text.Muted}" Margin="4,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasNext, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding CostText}" Style="{StaticResource Text.Muted}" Margin="4,6,0,90" Foreground="{DynamicResource Brush.TextTertiary}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- La barre de l'étape, toujours à portée : lancer, continuer, ou c'est réglé. -->
        <Border VerticalAlignment="Bottom" Padding="28,14" BorderThickness="0,1,0,0"
                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                Visibility="{Binding IsResult, Converter={StaticResource BoolToVisibility}}">
            <DockPanel MaxWidth="1000">
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Ghost}" Content="Nouveau" Command="{Binding BackCommand}" Margin="0,0,10,0" />
                    <!-- Un seul bouton plein à la fois : lancer tant qu'il reste à lancer, puis continuer ou conclure. -->
                    <Button Style="{StaticResource Button.Primary}" Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" Margin="0,0,10,0"
                            Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Button.Primary}" Content="{Binding ContinueLabel}" Command="{Binding ContinueCommand}" Margin="0,0,10,0"
                            Visibility="{Binding ContinueIsPrimary, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="{Binding ContinueLabel}" Command="{Binding ContinueCommand}" Margin="0,0,10,0"
                            Visibility="{Binding ContinueIsPrimary, Converter={StaticResource HiddenWhenTrue}}" />
                    <Button Style="{StaticResource Button.Primary}" Content="C'est réglé" Command="{Binding SolvedCommand}"
                            Visibility="{Binding SolvedIsPrimary, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="C'est réglé" Command="{Binding SolvedCommand}"
                            Visibility="{Binding SolvedIsPrimary, Converter={StaticResource HiddenWhenTrue}}" />
                </WrapPanel>
                <TextBlock Text="{Binding ApplyText}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="0,0,16,0" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
