<UserControl x:Class="LDI12.App.Views.DisksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LDI12.App">

    <UserControl.Resources>
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="MinWidth" Value="190" />
        </Style>

        <!-- La pastille d'état d'un attribut, d'un autotest : vert, orange ou rouge. -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource Brush.StatusGood}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="Warning">
                    <Setter Property="Fill" Value="{DynamicResource Brush.StatusWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Bad">
                    <Setter Property="Fill" Value="{DynamicResource Brush.StatusProblem}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1440" Margin="28,30,28,36">

            <ContentControl Style="{StaticResource PageHeader}" Tag="{StaticResource Icon.Disc}" Content="Disques" local:Motion.Entrance="True" />
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,18" TextWrapping="Wrap"
                       Text="L'état SMART commenté, l'autotest du disque, la lecture chronométrée de sa surface et l'optimisation de Windows. Rien n'est écrit sur le disque testé." />

            <!-- ===== Aucun disque ===== -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14"
                    Visibility="{Binding HasDisks, Converter={StaticResource HiddenWhenTrue}}">
                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                           Text="Aucun disque physique n'a été lu. Relancez l'analyse depuis la vue d'ensemble." />
            </Border>

            <!-- ===== Le disque ===== -->
            <Border Style="{StaticResource SegmentRail}" HorizontalAlignment="Left" Margin="0,0,0,14"
                    Visibility="{Binding HasDisks, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Disks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" IsChecked="{Binding IsSelected}" GroupName="DiskSegment" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <StackPanel Visibility="{Binding HasDisks, Converter={StaticResource BoolToVisibility}}">

                <!-- ===== La santé ===== -->
                <Border CornerRadius="{DynamicResource Radius.Card}" BorderThickness="1" Padding="22,18" Margin="0,0,0,14" local:Motion.Entrance="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.StatusGoodSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusGood}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HealthTone}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource Brush.StatusWarningSoft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusWarning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HealthTone}" Value="Bad">
                                    <Setter Property="Background" Value="{DynamicResource Brush.StatusProblemSoft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusProblem}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HealthTone}" Value="Unknown">
                                    <Setter Property="Background" Value="{DynamicResource Brush.StatusInfoSoft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusInfo}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Width="22" Height="22" Margin="0,2,16,0" VerticalAlignment="Top">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Data" Value="{StaticResource Icon.CheckCircle}" />
                                    <Setter Property="Stroke" Value="{DynamicResource Brush.StatusGood}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HealthTone}" Value="Warning">
                                            <Setter Property="Data" Value="{StaticResource Icon.AlertTriangle}" />
                                            <Setter Property="Stroke" Value="{DynamicResource Brush.StatusWarning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HealthTone}" Value="Bad">
                                            <Setter Property="Data" Value="{StaticResource Icon.AlertTriangle}" />
                                            <Setter Property="Stroke" Value="{DynamicResource Brush.StatusProblem}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HealthTone}" Value="Unknown">
                                            <Setter Property="Data" Value="{StaticResource Icon.Disc}" />
                                            <Setter Property="Stroke" Value="{DynamicResource Brush.StatusInfo}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <StackPanel>
                            <TextBlock Text="SANTÉ DU DISQUE" Style="{StaticResource Text.Eyebrow}" />
                            <TextBlock Text="{Binding HealthTitle}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{Binding HealthReasons}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,5">
                                            <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Margin="2,8,10,0" VerticalAlignment="Top"
                                                     Fill="{DynamicResource Brush.TextSecondary}" />
                                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ===== Les chiffres ===== -->
                <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,-10,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Metric}" />
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===== Les attributs SMART ===== -->
                <TextBlock Text="ATTRIBUTS SMART" Style="{StaticResource Text.Eyebrow}" Margin="2,10,0,10"
                           Visibility="{Binding HasAttributes, Converter={StaticResource BoolToVisibility}}" />
                <Border Style="{StaticResource Card}" Padding="20,12" Margin="0,0,0,14"
                        Visibility="{Binding HasAttributes, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="ID" Style="{StaticResource Text.Muted}" />
                            <TextBlock Grid.Column="2" Text="Attribut" Style="{StaticResource Text.Muted}" />
                            <TextBlock Grid.Column="3" Text="Actuel / pire / seuil" Style="{StaticResource Text.Muted}" />
                            <TextBlock Grid.Column="4" Text="Valeur brute" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Attributes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{Binding Id}" FontFamily="Consolas" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Values}" FontFamily="Consolas" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Raw}" FontFamily="Consolas" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding Meaning}" Style="{StaticResource Text.Muted}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Visibility="{Binding HasMeaning, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== Autotest et optimisation ===== -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="AUTOTEST DU DISQUE" Style="{StaticResource Text.Eyebrow}" />
                            <TextBlock Text="{Binding SelfTestText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource Button.Primary}" Content="Test court" Command="{Binding ShortTestCommand}" Margin="0,0,8,6" />
                                <Button Style="{StaticResource Button.Ghost}" Content="Test long" Command="{Binding LongTestCommand}" Margin="0,0,8,6" />
                                <Button Style="{StaticResource Button.Ghost}" Content="Relire le journal" Command="{Binding ReadTestCommand}" Margin="0,0,0,6" />
                            </WrapPanel>
                            <TextBlock Text="{Binding SelfTestResult}" Style="{StaticResource Text.Emphasis}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <ProgressBar Style="{StaticResource Progress}" Height="4" Maximum="1" Margin="0,8,0,0" Value="{Binding SelfTestProgress, Mode=OneWay}"
                                         Visibility="{Binding SelfTestRunning, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding SelfTestLog}" Margin="0,10,0,0"
                                          Visibility="{Binding HasSelfTestLog, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,6,12,0" VerticalAlignment="Top">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.StatusProblem}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Passed}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.StatusGood}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="OPTIMISATION" Style="{StaticResource Text.Eyebrow}" />
                            <TextBlock Text="{Binding OptimizeText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding HasVolumes, Converter={StaticResource HiddenWhenTrue}}"
                                       Text="Aucun volume avec une lettre sur ce disque." />
                            <ItemsControl ItemsSource="{Binding Volumes}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,5">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Optimiser"
                                                    Command="{Binding OptimizeCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Margin="0,0,14,0"
                                                    Background="{DynamicResource Brush.SurfaceHover}">
                                                <TextBlock Text="{Binding Letter}" Style="{StaticResource Text.Emphasis}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== La surface ===== -->
                <TextBlock Text="TEST DE SURFACE" Style="{StaticResource Text.Eyebrow}" Margin="2,10,0,10" />
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Button.Ghost}" Content="Arrêter" Command="{Binding StopScanCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                                <Button Style="{StaticResource Button.Primary}" Content="Lire la surface" Command="{Binding ScanCommand}" />
                            </StackPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource SegmentRail}" Margin="0,0,16,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="ScanDepth" Style="{StaticResource Segment}" Content="Rapide" IsChecked="{Binding IsQuickScan}" />
                                    <RadioButton GroupName="ScanDepth" Style="{StaticResource Segment}" Content="Complet" IsChecked="{Binding IsFullScan}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding ScanText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource Progress}" Height="4" Maximum="1" Margin="0,12,0,0" Value="{Binding ScanProgress, Mode=OneWay}"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}" Margin="0,14,0,0">
                            <!-- Une case par zone du disque, du début (en haut à gauche) à la fin : la pire lecture l'emporte. -->
                            <Border CornerRadius="10" Padding="10" Background="{DynamicResource Brush.SurfaceHover}">
                                <Image Source="{Binding Map}" Stretch="Uniform" MaxHeight="300" HorizontalAlignment="Left"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Histogram}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,22,6" MinWidth="120">
                                            <Border DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="3" Margin="0,0,8,0"
                                                    VerticalAlignment="Center" Background="{Binding Swatch}" />
                                            <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center">
                                                <Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="2,4,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
