<UserControl x:Class="LDI12.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LDI12.App"
             xmlns:controls="clr-namespace:LDI12.App.Controls">

    <UserControl.Resources>
        <Style x:Key="ThresholdBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.BrandRed}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.BrandRed}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.SurfaceHover}"
                                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Control}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource Brush.BrandRed}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource Brush.StatusWarning}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1440" Margin="28,30,28,36">

            <ContentControl Style="{StaticResource PageHeader}" Tag="{StaticResource Icon.Sliders}" Content="Réglages"
                            local:Motion.Entrance="True" />
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,4" MaxWidth="1100"
                       HorizontalAlignment="Left"
                       Text="Les seuils qui déclenchent les constats. Ils changent ce qui est signalé, jamais ce qui est mesuré." />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"
                       MaxWidth="1100" HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource Button.Primary}" Content="Enregistrer les seuils"
                        Command="{Binding SaveCommand}" />
                <Button Style="{StaticResource Button.Ghost}" Content="Annuler les modifications"
                        Margin="10,0,0,0" Command="{Binding RevertCommand}" />
                <Button Style="{StaticResource Button.Ghost}" Content="Revenir au barème d'origine"
                        Margin="10,0,0,0" Command="{Binding ResetCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding ProfilePath}" Style="{StaticResource Text.Muted}" Margin="2,12,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ProfilePath}" />

            <!-- ===== Mises à jour =====
                 Le seul échange réseau du logiciel en dehors des sondes réseau. L'écran dit ce
                 qui part, parce qu'un technicien chez un client doit pouvoir le lui répéter. -->
            <TextBlock Text="MISES À JOUR" Style="{StaticResource Text.Eyebrow}" Margin="2,26,0,10" />
            <Border Style="{StaticResource Card}" Padding="20,17" local:Motion.Entrance="True">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CheckUpdatesOnStartup}">
                        <TextBlock Text="Vérifier au démarrage s'il existe une version plus récente"
                                   Style="{StaticResource Text.Body}"
                                   Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" />
                    </CheckBox>

                    <TextBlock Style="{StaticResource Text.Body}" Margin="27,9,0,0" MaxWidth="980"
                               HorizontalAlignment="Left"
                               Text="N'envoie que la version installée et la famille de Windows, rien qui identifie la machine. Réponse signée, téléchargement vérifié." />

                    <TextBlock Style="{StaticResource Text.Muted}" Margin="27,8,0,0" MaxWidth="980"
                               HorizontalAlignment="Left"
                               Text="Sans connexion : aucun message, aucune attente." />

                    <TextBlock Style="{StaticResource Text.Muted}" Margin="27,8,0,0" MaxWidth="980"
                               HorizontalAlignment="Left"
                               Text="Une version ordinaire est proposée ; une correction critique s'installe d'elle-même, y compris depuis une clé USB." />

                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Text.Muted}"
                               Margin="27,12,0,0" MaxWidth="980" HorizontalAlignment="Left" />

                    <TextBlock Text="{Binding UpdatesPath}" Style="{StaticResource Text.Muted}"
                               Margin="27,6,0,0" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding UpdatesPath}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- ===== Capteurs matériels =====
                 Le seul réglage du logiciel qui installe quelque chose sur la machine. L'écran
                 dit ce qu'il engage plutôt que de se contenter d'un libellé : c'est la différence
                 entre un choix et un piège. -->
            <TextBlock Text="CAPTEURS MATÉRIELS" Style="{StaticResource Text.Eyebrow}" Margin="2,26,0,10" />
            <Border Style="{StaticResource Card}" Padding="20,17" local:Motion.Entrance="True">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AdvancedSensors}">
                        <TextBlock Text="Lire la température du processeur et les sondes de la carte mère"
                                   Style="{StaticResource Text.Body}"
                                   Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" />
                    </CheckBox>

                    <TextBlock Style="{StaticResource Text.Body}" Margin="27,9,0,0" MaxWidth="980"
                               HorizontalAlignment="Left"
                               Text="Windows ne donne pas la température du processeur : la lire demande un pilote noyau, comme le font HWMonitor ou HWiNFO." />

                    <TextBlock Style="{StaticResource Text.Muted}" Margin="27,8,0,0" MaxWidth="980"
                               HorizontalAlignment="Left"
                               Foreground="{DynamicResource Brush.StatusWarning}"
                               Text="Attention : ce pilote, WinRing0, est sur la liste des pilotes vulnérables de Microsoft. Defender peut le signaler (« VulnerableDriver:WinNT/Winring0 ») ou le bloquer. Il n'est chargé que le temps de l'analyse, puis retiré. Sur la machine d'un client, à annoncer avant de cocher." />

                    <TextBlock Style="{StaticResource Text.Muted}" Margin="27,8,0,0" MaxWidth="980"
                               HorizontalAlignment="Left"
                               Text="Apporte : température du processeur, sondes et ventilateurs de la carte mère, température des disques." />

                    <TextBlock Text="{Binding SensorStatus}" Style="{StaticResource Text.Muted}"
                               Margin="27,10,0,0" MaxWidth="980" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- ===== Empreinte du logiciel =====
                 Un outil qu'on emmène chez les gens doit pouvoir dire ce qu'il a laissé, et le
                 retirer. Le relevé s'affiche sans qu'on le demande ; la suppression, elle, exige
                 d'avoir vu la liste : c'est le typage de l'action qui l'impose, pas cet écran. -->
            <TextBlock Text="TRACES DE CE LOGICIEL" Style="{StaticResource Text.Eyebrow}" Margin="2,26,0,10" />
            <Border Style="{StaticResource Card}" Padding="20,17" local:Motion.Entrance="True">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}" MaxWidth="980" HorizontalAlignment="Left"
                               Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold"
                               Text="Ce logiciel écrit dans un seul dossier du profil de l'utilisateur." />

                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" MaxWidth="980"
                               HorizontalAlignment="Left"
                               Text="Journaux, barème, diagnostics archivés et journal d'intervention. Rien dans le registre, aucun service, aucune tâche." />

                    <TextBlock Text="{Binding FootprintSummary}" Style="{StaticResource Text.Muted}"
                               Margin="0,10,0,0" MaxWidth="980" HorizontalAlignment="Left"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Ghost}" Content="Voir ce qui serait supprimé"
                                Command="{Binding MeasureFootprintCommand}" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Effacer" Margin="10,0,0,0"
                                Command="{Binding RemoveFootprintCommand}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding FootprintLines}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap" MaxWidth="980" Margin="0,0,0,4"
                                           HorizontalAlignment="Left" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="SEUILS DE DÉCLENCHEMENT" Style="{StaticResource Text.Eyebrow}" Margin="2,26,0,0" />

            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Eyebrow}"
                                       Margin="2,18,0,10" />

                            <Border Style="{StaticResource Card}" Padding="20,14"
                                    local:Motion.Entrance="True">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <!-- PairGrid : un effet un peu long ne doit pas étirer les
                                         quinze autres lignes à sa hauteur. -->
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:PairGrid Columns="2" ColumnGap="28" MinColumnWidth="420" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                                    BorderThickness="0,0,0,1" Padding="0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding Label}"
                                                                   Style="{StaticResource Text.Body}"
                                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                                        <TextBlock Text="{Binding Effect}"
                                                                   Style="{StaticResource Text.Muted}"
                                                                   Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding RangeLabel}"
                                                                   Style="{StaticResource Text.Muted}"
                                                                   FontSize="{DynamicResource Font.Size.Caption}"
                                                                   Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Problem}"
                                                                   Style="{StaticResource Text.Muted}"
                                                                   Foreground="{DynamicResource Brush.StatusWarning}"
                                                                   Margin="0,3,0,0"
                                                                   Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>

                                                    <TextBox Grid.Column="1" Style="{StaticResource ThresholdBox}"
                                                             MinWidth="86" VerticalAlignment="Top"
                                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Grid.Column="2" Text="{Binding Unit}"
                                                               Style="{StaticResource Text.Muted}"
                                                               MinWidth="66" Margin="8,10,0,0"
                                                               VerticalAlignment="Top" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Analyse personnalisée =====
                 Deux besoins d'atelier : écarter un module qui cale sur une machine malade, et
                 rejouer un seul domaine après une réparation sans refaire quatre minutes. -->
            <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="ANALYSE PERSONNALISÉE" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,7,0,0" MaxWidth="960"
                               HorizontalAlignment="Left" TextWrapping="Wrap"
                               Text="Choisir les modules : utile quand l'un d'eux cale, ou pour rejouer un seul domaine après une réparation." />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Ghost}" Content="Tout"
                                Command="{Binding SelectAllCommand}" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Comme une analyse rapide"
                                Command="{Binding SelectQuickCommand}" Margin="10,0,0,0" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Rien"
                                Command="{Binding SelectNoneCommand}" Margin="10,0,0,0" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Modules}" Margin="0,16,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="300" Margin="0,0,12,10" Padding="14,10"
                                        Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Card}">
                                    <StackPanel>
                                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsSelected}"
                                                  Content="{Binding Name}" />
                                        <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource Text.Muted}"
                                                   Margin="26,4,0,0" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Muted}"
                                                   Margin="26,4,0,0" TextWrapping="Wrap" FontStyle="Italic"
                                                   Opacity="0.85"
                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Ce que la sélection coûte, et ce qu'elle coûte à la note : la seconde
                         phrase est la raison d'être de ce résumé. -->
                    <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Text.Body}"
                               Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="960"
                               HorizontalAlignment="Left" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource Button.Primary}" Content="Analyser la sélection"
                                Command="{Binding RunSelectionCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- L'identité du logiciel, ses licences et ses composants ont leur propre écran :
                 ils n'ont rien à faire au bas d'une page de seuils, où personne ne les cherche. -->
            <TextBlock Style="{StaticResource Text.Muted}" Margin="2,26,0,0" TextWrapping="Wrap"
                       MaxWidth="960" HorizontalAlignment="Left"
                       Text="Version, licences, composants embarqués et coordonnées : écran « À propos », juste en dessous." />

        </StackPanel>
    </ScrollViewer>
</UserControl>
