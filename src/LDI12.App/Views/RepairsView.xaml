<UserControl x:Class="LDI12.App.Views.RepairsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LDI12.App">

    <!-- Même réserve portée par le contenu que sur les autres écrans : ScrollViewer.Padding
         découperait le contenu 30 points avant le bord réel du cadre. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1440" Margin="28,30,28,36">

            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Icon}" Width="20" Height="20"
                      Data="{StaticResource Icon.Wrench}"
                      Stroke="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                <TextBlock Text="Réparations" Style="{StaticResource Text.Title}" Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Body}" Margin="0,8,0,18"
                       MaxWidth="1100" HorizontalAlignment="Left" />

            <!-- ===== Filet de sécurité ===== -->
            <Border Style="{StaticResource Card}" Padding="20,17" local:Motion.Entrance="True">
                <StackPanel>
                    <TextBlock Text="AVANT D'INTERVENIR" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,7,0,0" MaxWidth="980"
                               HorizontalAlignment="Left"
                               Text="Un point de restauration permet à Windows de revenir à son état actuel. Il n'est demandé nulle part automatiquement : sur un vidage de cache DNS il ferait perdre plusieurs minutes pour rien, et une protection qu'on contourne à chaque fois finit par ne plus protéger." />
                    <TextBlock Text="{Binding RestoreStatus}" Style="{StaticResource Text.Muted}"
                               Margin="0,10,0,0" MaxWidth="980" HorizontalAlignment="Left" />
                    <Button Style="{StaticResource Button.Ghost}" Content="Créer un point de restauration"
                            HorizontalAlignment="Left" Margin="0,13,0,0"
                            Command="{Binding CreateRestorePointCommand}" />
                </StackPanel>
            </Border>

            <!-- ===== Les actions ===== -->
            <TextBlock Text="OPÉRATIONS DISPONIBLES" Style="{StaticResource Text.Eyebrow}" Margin="2,22,0,10" />

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="0"
                                local:Motion.Entrance="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource RiskStripe}" Margin="15,16,0,16" />

                                <StackPanel Grid.Column="1" Margin="13,16,20,16">

                                    <!-- Titre, catégorie, risque -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                   Style="{StaticResource Text.Body}"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   FontWeight="SemiBold" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding RiskLabel}" Style="{StaticResource RiskBadge}" />
                                            <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource Text.Muted}"
                                                       Margin="10,0,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Purpose}" Style="{StaticResource Text.Body}"
                                               Margin="0,8,0,0" MaxWidth="1080" HorizontalAlignment="Left" />

                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <TextBlock Text="{Binding DurationLabel}" Style="{StaticResource Text.Muted}" />
                                        <TextBlock Text="·" Style="{StaticResource Text.Muted}" Margin="8,0" />
                                        <TextBlock Text="{Binding ElevationLabel}" Style="{StaticResource Text.Muted}" />
                                    </StackPanel>

                                    <!-- Indisponible : la raison, et ce qu'on peut faire à la place -->
                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding IsAvailable, Converter={StaticResource HiddenWhenTrue}}">
                                        <TextBlock Text="{Binding UnavailableReason}"
                                                   Style="{StaticResource Text.Muted}"
                                                   Foreground="{DynamicResource Brush.StatusWarning}"
                                                   MaxWidth="1080" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding Workaround}" Style="{StaticResource Text.Muted}"
                                                   Margin="0,4,0,0" MaxWidth="1080" HorizontalAlignment="Left"
                                                   Visibility="{Binding HasWorkaround, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <!-- Commandes -->
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
                                        <Button Style="{StaticResource Button.Ghost}"
                                                Content="Prévisualiser"
                                                Command="{Binding PreviewCommand}" />
                                        <Button Style="{StaticResource Button.Primary}" Content="Exécuter"
                                                Margin="10,0,0,0"
                                                Command="{Binding RequestExecuteCommand}"
                                                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource Button.Ghost}" Content="Interrompre"
                                                Margin="10,0,0,0"
                                                Command="{Binding CancelCommand}"
                                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Muted}"
                                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>

                                    <!-- Ce qui va se passer -->
                                    <Border Style="{StaticResource PreviewPanel}"
                                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="CE QUI VA SE PASSER" Style="{StaticResource Text.Eyebrow}" />
                                            <TextBlock Text="{Binding PreviewSummary}" Style="{StaticResource Text.Body}"
                                                       Margin="0,7,0,0" MaxWidth="1000" HorizontalAlignment="Left" />

                                            <ItemsControl ItemsSource="{Binding WillDo}" Margin="0,10,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}"
                                                                   Margin="0,0,0,3" MaxWidth="1000"
                                                                   HorizontalAlignment="Left" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Ce qui ne sera pas touché : c'est la question du client -->
                                            <TextBlock Text="CE QUI N'EST PAS TOUCHÉ" Style="{StaticResource Text.Eyebrow}"
                                                       Margin="0,14,0,0"
                                                       Visibility="{Binding HasWillNotDo, Converter={StaticResource BoolToVisibility}}" />
                                            <ItemsControl ItemsSource="{Binding WillNotDo}" Margin="0,7,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}"
                                                                   Foreground="{DynamicResource Brush.StatusGood}"
                                                                   Margin="0,0,0,3" MaxWidth="1000"
                                                                   HorizontalAlignment="Left" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl ItemsSource="{Binding Measurements}" Margin="0,12,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                       Style="{StaticResource Text.Muted}"
                                                                       MinWidth="180" MaxWidth="220"
                                                                       VerticalAlignment="Top" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                                       Style="{StaticResource PreviewValue}"
                                                                       Margin="16,0,0,0" MaxWidth="780"
                                                                       HorizontalAlignment="Left" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Confirmation, pour les actions qui engagent la machine -->
                                    <Border Style="{StaticResource ConfirmPanel}"
                                            Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Emphasis}"
                                                       Text="Confirmer l'exécution" />
                                            <TextBlock Text="{Binding PreviewSummary}" Style="{StaticResource Text.Body}"
                                                       Margin="0,6,0,0" MaxWidth="1000" HorizontalAlignment="Left" />
                                            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                                <Button Style="{StaticResource Button.Primary}"
                                                        Content="Oui, exécuter maintenant"
                                                        Command="{Binding ConfirmExecuteCommand}" />
                                                <Button Style="{StaticResource Button.Ghost}" Content="Annuler"
                                                        Margin="10,0,0,0" Command="{Binding AbandonCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Ce qui s'est passé -->
                                    <Border Style="{StaticResource OutcomePanel}"
                                            Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding OutcomeStatusLabel}"
                                                       Style="{StaticResource Text.Eyebrow}" />
                                            <TextBlock Text="{Binding OutcomeSummary}" Style="{StaticResource Text.Body}"
                                                       Margin="0,6,0,0" MaxWidth="1000" HorizontalAlignment="Left" />

                                            <ItemsControl ItemsSource="{Binding OutcomeDetails}" Margin="0,9,0,0"
                                                          Visibility="{Binding HasOutcomeDetails, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}"
                                                                   Margin="0,0,0,3" MaxWidth="1000"
                                                                   HorizontalAlignment="Left" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- La sortie brute reste accessible : quand rien d'autre n'aide,
                                                 c'est elle qui sert. -->
                                            <Expander Style="{StaticResource Detail}" Margin="0,10,0,0"
                                                      Header="Sortie complète de l'outil"
                                                      Visibility="{Binding HasRawOutput, Converter={StaticResource BoolToVisibility}}">
                                                <TextBox Text="{Binding RawOutput, Mode=OneWay}" IsReadOnly="True"
                                                         BorderThickness="0" Background="Transparent"
                                                         Foreground="{DynamicResource Brush.TextTertiary}"
                                                         FontFamily="Consolas" FontSize="11.5"
                                                         MaxHeight="260" TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto" Margin="0,8,0,0" />
                                            </Expander>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
