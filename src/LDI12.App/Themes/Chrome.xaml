<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Barre de titre de l'application.

         La fenêtre n'a plus de cadre système : c'est ici que se dessinent les trois boutons qui
         le remplacent. Deux règles guident ce fichier.

         1. Les glyphes ne sont pas des icônes Lucide. Windows dessine ces quatre symboles au
            trait d'un pixel depuis Windows 10, et le technicien les reconnaît sans les lire.
            Les redessiner « à notre façon » ferait perdre une seconde à chaque fermeture.
            Repère commun : 10 × 10, tracé à l'échelle 1 (Stretch=None) pour rester net.

         2. Les dimensions sont celles de Windows : 46 points de large, toute la hauteur de la
            barre. Le bouton de fermeture vire au rouge au survol, les deux autres à un simple
            voile clair. C'est la convention, et une convention respectée ne se remarque pas. -->

    <Geometry x:Key="Glyph.Minimize">M0.5,5.5 H9.5</Geometry>
    <Geometry x:Key="Glyph.Maximize">M0.5,0.5 H9.5 V9.5 H0.5 Z</Geometry>
    <Geometry x:Key="Glyph.Restore">M2.5,2.5 V0.5 H9.5 V7.5 H7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z</Geometry>
    <Geometry x:Key="Glyph.Close">M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5</Geometry>

    <Style x:Key="CaptionGlyph" TargetType="Path">
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                         Value="True">
                <Setter Property="Stroke" Value="{DynamicResource Brush.TextPrimary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Sur l'aplat rouge de la fermeture, la croix passe au blanc dans les deux thèmes : le
         contraste ne dépend plus de la surface qui est derrière. -->
    <Style x:Key="CaptionGlyph.Close" TargetType="Path" BasedOn="{StaticResource CaptionGlyph}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                         Value="True">
                <Setter Property="Stroke" Value="#FFFFFFFF" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Hover" Opacity="0"
                                Background="{DynamicResource Brush.CaptionHover}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionButton.Close" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Hover" Opacity="0"
                                Background="{DynamicResource Brush.CaptionClose}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
