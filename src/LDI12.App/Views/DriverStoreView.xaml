<UserControl x:Class="LDI12.App.Views.DriverStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LDI12.App">

    <UserControl.Resources>
        <Style x:Key="PackageItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,0,0,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,30,28,24" MaxWidth="1440">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" local:Motion.Entrance="True">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Relire" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
                <ContentControl Style="{StaticResource PageHeader}" Tag="{StaticResource Icon.Package}" Content="Magasin de pilotes" />
            </DockPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" Margin="0,8,0,16" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="520" Margin="14,0,0,0" />
            <Border Style="{StaticResource SegmentRail}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="StoreFilter" Style="{StaticResource Segment}" Content="{Binding AllLabel}" IsChecked="{Binding IsAll}" />
                    <RadioButton GroupName="StoreFilter" Style="{StaticResource Segment}" Content="{Binding OldLabel}" IsChecked="{Binding IsOld}" />
                    <RadioButton GroupName="StoreFilter" Style="{StaticResource Segment}" Content="{Binding UnusedLabel}" IsChecked="{Binding IsUnused}" />
                    <RadioButton GroupName="StoreFilter" Style="{StaticResource Segment}" Content="{Binding InUseLabel}" IsChecked="{Binding IsInUse}" />
                </StackPanel>
            </Border>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,8,6,8">
            <Grid>
                <ProgressBar Style="{StaticResource Progress}" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Margin="6,2,6,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <ListBox ItemsSource="{Binding View}" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource PackageItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCheck}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Emphasis}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Names}" Style="{StaticResource Text.Muted}" FontFamily="Consolas" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="8" Padding="9,3" Margin="12,0,12,0" VerticalAlignment="Center" MaxWidth="320">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKey}" Value="InUse">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.StatusGoodSoft}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKey}" Value="OldVersion">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.StatusWarningSoft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Typography.NumeralAlignment="Tabular" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- La barre d'action : ce qui est coché, et le geste. -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="20,14" Margin="0,12,0,0"
                Visibility="{Binding HasPackages, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Retirer la sélection" Command="{Binding DeleteCommand}" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Text.Emphasis}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Point de restauration avant. Un pilote en service n'est jamais retiré : Windows le refuse de lui-même." />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
