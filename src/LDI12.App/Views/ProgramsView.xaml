<UserControl x:Class="LDI12.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LDI12.App">

    <UserControl.Resources>
        <!-- Une ligne de liste : surbrillance douce au survol, cadre rouge pour la sélection. -->
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="Transparent" Margin="0,0,0,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.BrandRedSoft}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.BrandRed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        </Style>

        <!-- Une petite étiquette d'alerte : non signé, introuvable. -->
        <Style x:Key="Flag" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,30,28,24" MaxWidth="1440">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" local:Motion.Entrance="True">
            <ContentControl Style="{StaticResource PageHeader}" Tag="{StaticResource Icon.Layers}" Content="Programmes" />
            <TextBlock Margin="0,8,0,16" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                        <Setter Property="Text" Value="{Binding Summary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAutorunsTab}" Value="True">
                                <Setter Property="Text" Value="{Binding AutorunSummary}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Onglets, tri ou catégories, recherche. -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Border DockPanel.Dock="Left" Style="{StaticResource SegmentRail}" Margin="0,0,14,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="ProgramsTab" Style="{StaticResource Segment}" Content="En cours" IsChecked="{Binding IsProcessesTab}" />
                    <RadioButton GroupName="ProgramsTab" Style="{StaticResource Segment}" Content="Au démarrage" IsChecked="{Binding IsAutorunsTab}" />
                </StackPanel>
            </Border>
            <TextBox DockPanel.Dock="Right" Style="{StaticResource Field}" Width="230" Tag="Rechercher un nom, un éditeur, un chemin"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
            <!-- Les réglages de la liste de démarrage tiennent ici : la barre des catégories garde toute la largeur de la carte. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                        Visibility="{Binding IsAutorunsTab, Converter={StaticResource BoolToVisibility}}">
                <CheckBox Style="{StaticResource Switch}" Content="Masquer Microsoft" IsChecked="{Binding HideMicrosoft}" VerticalAlignment="Center" />
                <Button Style="{StaticResource Button.Ghost}" Content="Relire" Command="{Binding RefreshAutorunsCommand}" Margin="12,0,0,0" />
            </StackPanel>
            <Grid />
        </DockPanel>

        <!-- ===== En cours ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,10,6,8"
                Visibility="{Binding IsProcessesTab, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,0,8,8">
                    <Border DockPanel.Dock="Left" Style="{StaticResource SegmentRail}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="ProcessSort" Style="{StaticResource Segment}" Content="Arborescence" IsChecked="{Binding IsTreeSort}" />
                            <RadioButton GroupName="ProcessSort" Style="{StaticResource Segment}" Content="Processeur" IsChecked="{Binding IsCpuSort}" />
                            <RadioButton GroupName="ProcessSort" Style="{StaticResource Segment}" Content="Mémoire" IsChecked="{Binding IsMemorySort}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                </DockPanel>

                <!-- En-têtes de colonnes. -->
                <Grid DockPanel.Dock="Top" Margin="11,0,14,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PROCESSUS" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Grid.Column="1" Text="ÉDITEUR" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Grid.Column="2" Text="PROCESSEUR" Style="{StaticResource Text.Eyebrow}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="MÉMOIRE" Style="{StaticResource Text.Eyebrow}" HorizontalAlignment="Right" />
                </Grid>

                <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding ProcessView}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <DockPanel Margin="{Binding Indent}" VerticalAlignment="Center" ClipToBounds="True">
                                    <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,9,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.StatusGood}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Identity}" Value="{x:Null}">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.StatusUnavailable}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUnsigned}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.StatusWarning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSuspicious}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.StatusProblem}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="10,0,10,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </DockPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Publisher}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="2" Text="{Binding CpuText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Typography.NumeralAlignment="Tabular" />
                                <TextBlock Grid.Column="3" Text="{Binding MemoryText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Typography.NumeralAlignment="Tabular" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Le processus choisi : ce qu'il est, d'où il vient, et ce qu'on peut en faire. -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="20,14" Margin="0,12,0,0"
                Visibility="{Binding ShowsDetail, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Primary}" Content="Terminer" Command="{Binding EndCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Terminer l'arborescence" Command="{Binding EndTreeCommand}" />
                    </WrapPanel>
                    <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Style="{StaticResource Button.Ghost}" Content="Ouvrir l'emplacement" Command="{Binding RevealCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Rechercher en ligne" Command="{Binding SearchCommand}" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Emphasis}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Selected.Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Selected.Description, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="Normal" />
                    </TextBlock>
                    <TextBlock Text="{Binding Selected.Signature}" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Selected.Path}" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CommandLine}" FontFamily="Consolas" Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                               TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SelectedDetail}" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Au démarrage ===== -->
        <Border Grid.Row="2" Grid.RowSpan="2" Style="{StaticResource Card}" Padding="8,10,6,8"
                Visibility="{Binding IsAutorunsTab, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,0,8,10">
                    <Border Style="{StaticResource SegmentRail}" HorizontalAlignment="Left">
                        <WrapPanel>
                            <RadioButton GroupName="AutorunCategory" Style="{StaticResource Segment}" Content="{Binding AllLabel}" IsChecked="{Binding IsAllCategory}" />
                            <RadioButton GroupName="AutorunCategory" Style="{StaticResource Segment}" Content="{Binding LogonLabel}" IsChecked="{Binding IsLogonCategory}" />
                            <RadioButton GroupName="AutorunCategory" Style="{StaticResource Segment}" Content="{Binding TaskLabel}" IsChecked="{Binding IsTaskCategory}" />
                            <RadioButton GroupName="AutorunCategory" Style="{StaticResource Segment}" Content="{Binding ServiceLabel}" IsChecked="{Binding IsServiceCategory}" />
                            <RadioButton GroupName="AutorunCategory" Style="{StaticResource Segment}" Content="{Binding DriverLabel}" IsChecked="{Binding IsDriverCategory}" />
                            <RadioButton GroupName="AutorunCategory" Style="{StaticResource Segment}" Content="{Binding ExplorerLabel}" IsChecked="{Binding IsExplorerCategory}" />
                            <RadioButton GroupName="AutorunCategory" Style="{StaticResource Segment}" Content="{Binding SensitiveLabel}" IsChecked="{Binding IsSensitiveCategory}" />
                        </WrapPanel>
                    </Border>
                </DockPanel>

                <StackPanel DockPanel.Dock="Top" Margin="6,0,6,10" Visibility="{Binding IsLoadingAutoruns, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar Style="{StaticResource Progress}" IsIndeterminate="True" Height="4" />
                </StackPanel>

                <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding AutorunView}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                            <Setter Property="Padding" Value="10,8" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,2,14,0"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"
                                          ToolTip="Lancé au démarrage" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <Button Style="{StaticResource Button.Ghost}" Content="Emplacement" Command="{Binding OpenCommand}" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource Button.Ghost}" Content="Rechercher" Command="{Binding SearchCommand}" />
                                </StackPanel>
                                <StackPanel>
                                    <!-- Le nom prend la place qui reste et se coupe ; les étiquettes restent entières. -->
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Text.Muted}" Foreground="{DynamicResource Brush.StatusWarning}" Margin="10,0,0,0" />
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Flag}" Background="{DynamicResource Brush.StatusWarningSoft}"
                                                Visibility="{Binding IsUnsigned, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="non signé" Style="{StaticResource Text.Muted}" Foreground="{DynamicResource Brush.StatusWarning}" />
                                        </Border>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Flag}" Background="{DynamicResource Brush.StatusProblemSoft}"
                                                Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="fichier introuvable" Style="{StaticResource Text.Muted}" Foreground="{DynamicResource Brush.StatusProblem}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Emphasis}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Publisher, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Location, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Detail, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Command}" FontFamily="Consolas" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
