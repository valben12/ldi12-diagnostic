<UserControl x:Class="LDI12.App.Views.CrashesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LDI12.App">

    <UserControl.Resources>
        <!-- Un chiffre et ce qu'il compte : trois en tête d'écran, lus d'un coup d'œil. -->
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1440" Margin="28,30,28,36">

            <DockPanel local:Motion.Entrance="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Relire"
                        Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
                <ContentControl Style="{StaticResource PageHeader}" Tag="{StaticResource Icon.MonitorX}" Content="Plantages" />
            </DockPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" Margin="0,8,0,18" />

            <!-- ===== Lecture en cours ===== -->
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Muted}" />
                <ProgressBar Style="{StaticResource Progress}" IsIndeterminate="True" Height="4" Margin="0,8,0,0" />
            </StackPanel>

            <!-- ===== Les trois chiffres ===== -->
            <Grid Margin="0,0,0,14" Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="0" Style="{StaticResource Text.Metric}" local:Motion.Count="{Binding BlueScreenCount}" />
                        <TextBlock Text="écrans bleus · 60 jours" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="0" Style="{StaticResource Text.Metric}" local:Motion.Count="{Binding ShutdownCount}" />
                        <TextBlock Text="arrêts brutaux sans écran bleu" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatTile}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="0" Style="{StaticResource Text.Metric}" local:Motion.Count="{Binding AppCrashCount}" />
                        <TextBlock Text="plantages de programmes" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== La conclusion ===== -->
            <Border CornerRadius="{DynamicResource Radius.Card}" BorderThickness="1" Padding="22,18" Margin="0,0,0,14"
                    local:Motion.Entrance="True"
                    Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.StatusGoodSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusGood}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VerdictTone}" Value="Warning">
                                <Setter Property="Background" Value="{DynamicResource Brush.StatusWarningSoft}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusWarning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding VerdictTone}" Value="Bad">
                                <Setter Property="Background" Value="{DynamicResource Brush.StatusProblemSoft}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusProblem}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Path DockPanel.Dock="Left" Width="22" Height="22" Margin="0,2,16,0" VerticalAlignment="Top">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                <Setter Property="Data" Value="{StaticResource Icon.CheckCircle}" />
                                <Setter Property="Stroke" Value="{DynamicResource Brush.StatusGood}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VerdictTone}" Value="Warning">
                                        <Setter Property="Data" Value="{StaticResource Icon.AlertTriangle}" />
                                        <Setter Property="Stroke" Value="{DynamicResource Brush.StatusWarning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding VerdictTone}" Value="Bad">
                                        <Setter Property="Data" Value="{StaticResource Icon.AlertTriangle}" />
                                        <Setter Property="Stroke" Value="{DynamicResource Brush.StatusProblem}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <StackPanel>
                        <TextBlock Text="CONCLUSION" Style="{StaticResource Text.Eyebrow}" />
                        <TextBlock Text="{Binding VerdictTitle}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding VerdictDetail}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <ItemsControl ItemsSource="{Binding Advice}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,5">
                                        <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Margin="2,8,10,0" VerticalAlignment="Top"
                                                 Fill="{DynamicResource Brush.TextSecondary}" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource Button.Primary}" Content="{Binding VerdictLinkLabel}"
                                    Command="{Binding VerdictLink.OpenCommand}" Margin="0,0,10,0"
                                    Visibility="{Binding HasVerdictLink, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding SolveCommand}">
                                <DockPanel>
                                    <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Width="13" Height="13" Margin="0,0,6,0"
                                          Data="{StaticResource Icon.Sparkles}" Stroke="{DynamicResource Brush.BrandRed}" />
                                    <TextBlock Text="Analyser avec l'assistant" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Les vidages ne sont pas encore lus ===== -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14"
                    Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Lire les rapports"
                            Command="{Binding ReadDumpsCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <StackPanel>
                        <TextBlock Text="Les rapports d'écran bleu ne sont pas encore lus" Style="{StaticResource Text.Emphasis}" />
                        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Text="Ce sont eux qui désignent le pilote en cause. Windows les réserve aux administrateurs : il demandera l'autorisation une fois." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Windows n'enregistre rien ===== -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14"
                    Visibility="{Binding DumpsDisabled, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="{Binding EnableDumpsLink.Label}"
                            Command="{Binding EnableDumpsLink.OpenCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <StackPanel>
                        <TextBlock Text="Windows ne garde aucune trace des écrans bleus" Style="{StaticResource Text.Emphasis}"
                                   Foreground="{DynamicResource Brush.StatusWarning}" />
                        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Text="Sans minividage, le prochain écran bleu ne pourra pas être expliqué. L'opération « Enregistrer les écrans bleus » le règle." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Les écrans bleus ===== -->
            <TextBlock Text="ÉCRANS BLEUS" Style="{StaticResource Text.Eyebrow}" Margin="2,10,0,10"
                       Visibility="{Binding HasBlueScreens, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding BlueScreens}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="20,16" local:Motion.Entrance="True">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="8" Padding="9,3" Background="{DynamicResource Brush.SurfaceHover}">
                                        <TextBlock Text="{Binding CodeHex}" FontFamily="Consolas" Style="{StaticResource Text.Muted}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Text.Muted}" />
                                        <TextBlock Text="{Binding CodeName}" Style="{StaticResource Text.Emphasis}" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Meaning}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,6,0,0" />

                                <!-- Le pilote mis en cause : ce que le technicien cherche en ouvrant l'écran. -->
                                <Border CornerRadius="10" Padding="14,10" Margin="0,12,0,0" Background="{DynamicResource Brush.SurfaceHover}">
                                    <DockPanel>
                                        <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Width="16" Height="16" Margin="0,2,12,0"
                                              VerticalAlignment="Top" Data="{StaticResource Icon.Package}"
                                              Stroke="{DynamicResource Brush.StatusProblem}" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Emphasis}" TextWrapping="Wrap">
                                                <Run Text="Pilote en cause : " Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="Normal" /><Run Text="{Binding SuspectTitle, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding SuspectDetail}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Expander Style="{StaticResource Detail}" Header="Détails techniques" Margin="0,10,0,0"
                                          IsExpanded="{Binding IsExpanded}"
                                          Visibility="{Binding HasDump, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Paramètres" Style="{StaticResource Text.Muted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Parameters}" FontFamily="Consolas" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Text="Adresse de l'arrêt" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AddressText}" FontFamily="Consolas" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="2" Text="Fichier" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FileText}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </Grid>
                                        <TextBlock Text="{Binding ModulesText}" Style="{StaticResource Text.Muted}" Margin="0,12,0,6" />
                                        <ItemsControl ItemsSource="{Binding Stack}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.TextTertiary}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSuspect}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource Brush.StatusProblem}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Name}" Width="190" FontFamily="Consolas" Style="{StaticResource Text.Body}" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Programmes qui plantent ===== -->
            <TextBlock Text="PROGRAMMES QUI PLANTENT OU SE FIGENT" Style="{StaticResource Text.Eyebrow}" Margin="2,14,0,10"
                       Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}}" />
            <Border Style="{StaticResource Card}" Padding="20,8" Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,8">
                                <Border DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="8" Padding="9,3" Margin="12,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.StatusProblemSoft}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHang}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.StatusWarningSoft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Tag}" Style="{StaticResource Text.Muted}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Emphasis}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="{Binding SettingsText}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="2,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
