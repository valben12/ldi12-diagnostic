<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:diag="clr-namespace:LDI12.Core.Diagnostics;assembly=LDI12.Core"
                    xmlns:model="clr-namespace:LDI12.Core.Model;assembly=LDI12.Core"
                    xmlns:probes="clr-namespace:LDI12.Core.Probes;assembly=LDI12.Core"
                    xmlns:facts="clr-namespace:LDI12.Reports.Facts;assembly=LDI12.Reports"
                    xmlns:vm="clr-namespace:LDI12.App.ViewModels">

    <!-- La couleur d'état est appliquée par déclencheur plutôt que par convertisseur : un
         convertisseur renverrait une brosse figée au moment de la conversion et ne suivrait pas
         la bascule de thème. Ici tout reste en DynamicResource. -->

    <Style x:Key="SeverityDot" TargetType="Ellipse">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Brush.StatusInfo}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:Severity.Critical}">
                <Setter Property="Fill" Value="{DynamicResource Brush.StatusCritical}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:Severity.Problem}">
                <Setter Property="Fill" Value="{DynamicResource Brush.StatusProblem}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:Severity.Warning}">
                <Setter Property="Fill" Value="{DynamicResource Brush.StatusWarning}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SeverityText" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:Severity.Critical}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusCritical}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:Severity.Problem}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusProblem}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:Severity.Warning}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusWarning}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Bandeau coloré à gauche d'un constat : l'état se lit avant même le texte. -->
    <Style x:Key="SeverityStripe" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Brush.StatusInfo}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:Severity.Critical}">
                <Setter Property="Background" Value="{DynamicResource Brush.StatusCritical}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:Severity.Problem}">
                <Setter Property="Background" Value="{DynamicResource Brush.StatusProblem}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:Severity.Warning}">
                <Setter Property="Background" Value="{DynamicResource Brush.StatusWarning}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Pastille de navigation : gravité maximale du domaine. -->
    <Style x:Key="NavBadge" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Worst}" Value="{x:Static diag:Severity.Critical}">
                <Setter Property="Fill" Value="{DynamicResource Brush.StatusCritical}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Worst}" Value="{x:Static diag:Severity.Problem}">
                <Setter Property="Fill" Value="{DynamicResource Brush.StatusProblem}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Worst}" Value="{x:Static diag:Severity.Warning}">
                <Setter Property="Fill" Value="{DynamicResource Brush.StatusWarning}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BandTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusGood}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Band}" Value="{x:Static model:ScoreBand.Attention}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusWarning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Band}" Value="{x:Static model:ScoreBand.Degraded}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusProblem}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Band}" Value="{x:Static model:ScoreBand.Critical}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusCritical}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BandMetric" TargetType="TextBlock" BasedOn="{StaticResource Text.Metric}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusGood}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Band}" Value="{x:Static model:ScoreBand.Attention}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusWarning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Band}" Value="{x:Static model:ScoreBand.Degraded}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusProblem}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Band}" Value="{x:Static model:ScoreBand.Critical}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusCritical}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEvaluated}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusUnavailable}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BandText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusGood}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Band}" Value="{x:Static model:ScoreBand.Attention}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusWarning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Band}" Value="{x:Static model:ScoreBand.Degraded}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusProblem}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Band}" Value="{x:Static model:ScoreBand.Critical}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusCritical}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BandBar" TargetType="ProgressBar" BasedOn="{StaticResource Progress}">
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusGood}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Band}" Value="{x:Static model:ScoreBand.Attention}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusWarning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Band}" Value="{x:Static model:ScoreBand.Degraded}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusProblem}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Band}" Value="{x:Static model:ScoreBand.Critical}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusCritical}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEvaluated}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusUnavailable}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Caractéristique relevée.

         Deux axes indépendants, et c'est le point important : l'état de la mesure (a-t-on su la
         lire ?) et son accent (la valeur est-elle bonne ?). Une valeur manquante s'affiche en
         gris et en italique, jamais en rouge : ne pas avoir su mesurer n'est pas un défaut de la
         machine, et le confondre avec un problème est exactement le mensonge que tout le modèle
         de données cherche à empêcher. -->
    <Style x:Key="FactValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static facts:FactTone.Good}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusGood}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static facts:FactTone.Warning}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusWarning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static facts:FactTone.Bad}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusCritical}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKnown}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                <Setter Property="FontStyle" Value="Italic" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Tuile de module sur l'écran d'analyse. Les dix-sept modules sont affichés dès le départ,
         en attente, et s'allument au fil de leur exécution réelle. Le technicien voit le plan
         avant l'exécution : c'est ce qu'il doit pouvoir dire au client qui regarde. -->
    <Style x:Key="ScanTile" TargetType="Border">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ScanModuleState.Running}">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BrandRed}" />
                <Setter Property="Background" Value="{DynamicResource Brush.BrandRedSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ScanModuleState.Done}">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                <!-- Brève dilatation au moment où le module aboutit : le regard est attiré là où
                     quelque chose vient réellement de se passer, et nulle part ailleurs. -->
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.ScaleX">
                                <EasingDoubleKeyFrame Value="1.07" KeyTime="0:0:0.09" />
                                <EasingDoubleKeyFrame Value="1" KeyTime="0:0:0.34">
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <PowerEase EasingMode="EaseOut" Power="3" />
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.ScaleY">
                                <EasingDoubleKeyFrame Value="1.07" KeyTime="0:0:0.09" />
                                <EasingDoubleKeyFrame Value="1" KeyTime="0:0:0.34">
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <PowerEase EasingMode="EaseOut" Power="3" />
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScanDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Brush.TrackBackground}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ScanModuleState.Running}">
                <Setter Property="Fill" Value="{DynamicResource Brush.BrandRed}" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="DotPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.3" Duration="0:0:0.55" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="DotPulse" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ScanModuleState.Done}">
                <Setter Property="Fill" Value="{DynamicResource Brush.StatusGood}" />
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScanTileText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="9,0,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ScanModuleState.Running}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ScanModuleState.Done}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Onde concentrique derrière l'anneau d'analyse. Trois exemplaires décalés dans le temps
         suffisent à donner le mouvement ; ce sont des cercles au trait, sans remplissage. -->
    <Style x:Key="ScanPulse" TargetType="Ellipse">
        <Setter Property="Width" Value="222" />
        <Setter Property="Height" Value="222" />
        <Setter Property="Stroke" Value="{DynamicResource Brush.BrandRed}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Un module qui n'a pas abouti se distingue, sans dramatiser : gris pour une donnée
         manquante, ambre pour un résultat partiel, rouge seulement pour un échec réel. -->
    <Style x:Key="ModuleDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Brush.StatusGood}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static probes:ProbeStatus.Partial}">
                <Setter Property="Fill" Value="{DynamicResource Brush.StatusWarning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static probes:ProbeStatus.ElevationRequired}">
                <Setter Property="Fill" Value="{DynamicResource Brush.StatusWarning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static probes:ProbeStatus.Unavailable}">
                <Setter Property="Fill" Value="{DynamicResource Brush.StatusUnavailable}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static probes:ProbeStatus.Skipped}">
                <Setter Property="Fill" Value="{DynamicResource Brush.StatusUnavailable}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static probes:ProbeStatus.Failed}">
                <Setter Property="Fill" Value="{DynamicResource Brush.StatusCritical}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static probes:ProbeStatus.TimedOut}">
                <Setter Property="Fill" Value="{DynamicResource Brush.StatusCritical}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Phase 5 : interventions ===== -->

    <!-- Le risque d'une action se lit avant son titre. Une action qui ne modifie rien n'a
         aucune raison d'attirer l'œil ; une action qui engage la machine, si. -->
    <Style x:Key="RiskBadge" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusGood}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RiskKey}" Value="ReadOnly">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RiskKey}" Value="Moderate">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusWarning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RiskKey}" Value="High">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusCritical}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Pastille reprise des constats, en retrait comme elles : même grammaire visuelle pour
         « voici ce que j'ai trouvé » et « voici ce que je m'apprête à faire ». -->
    <Style x:Key="RiskStripe" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Brush.StatusGood}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RiskKey}" Value="ReadOnly">
                <Setter Property="Background" Value="{DynamicResource Brush.StatusInfo}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RiskKey}" Value="Moderate">
                <Setter Property="Background" Value="{DynamicResource Brush.StatusWarning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RiskKey}" Value="High">
                <Setter Property="Background" Value="{DynamicResource Brush.StatusCritical}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Compte rendu d'exécution : la teinte suit le résultat réel, jamais l'intention. -->
    <Style x:Key="OutcomePanel" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.StatusGoodSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusGood}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding OutcomeKey}" Value="Partial">
                <Setter Property="Background" Value="{DynamicResource Brush.StatusWarningSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusWarning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding OutcomeKey}" Value="Bad">
                <Setter Property="Background" Value="{DynamicResource Brush.StatusCriticalSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusCritical}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Confirmation : volontairement plus voyante que le reste de l'écran. Il n'y a aucune
         raison qu'un clic qui supprime ressemble à un clic qui affiche. -->
    <Style x:Key="ConfirmPanel" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.StatusCriticalSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusCritical}" />
    </Style>

    <!-- Relevé de prévisualisation : encadré neutre, pour qu'on distingue au premier coup d'œil
         « voici ce qui va se passer » de « voici ce qui s'est passé ». -->
    <Style x:Key="PreviewPanel" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    </Style>

    <!-- Une ligne de relevé qui porte une conséquence se distingue d'une ligne de simple fait. -->
    <Style x:Key="PreviewValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCaution}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusWarning}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Case à cocher.
         Grille et non pile horizontale : dans une pile, le texte reçoit une largeur infinie, ne
         passe jamais à la ligne et se fait couper par la carte. C'est ce que montraient les
         captures de l'écran des données, descriptions tronquées en plein mot.
         La case suit la première ligne, et la coche apparaît en fondu, posée par un aplat au
         lieu d'un échange de couleur : un changement sec se lit comme un clignotement. -->
    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="17" Height="17" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Border x:Name="Box" CornerRadius="5"
                                    Background="{DynamicResource Brush.SurfaceHover}"
                                    BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" />
                            <Border x:Name="Fill" CornerRadius="5" Opacity="0"
                                    Background="{DynamicResource Brush.BrandRed}" />
                            <Path x:Name="Tick" Data="M4,8.5 L7,11.5 L13,5"
                                  Stroke="{DynamicResource Brush.TextOnAccent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform x:Name="TickScale" ScaleX="0.6" ScaleY="0.6" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.BrandRed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.6" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.6" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Console Windows absente : la carte s'éteint, mais sa raison reste lisible. -->
    <Style x:Key="ToolCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                <Setter Property="Opacity" Value="0.62" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
