<UserControl x:Class="LDI12.App.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LDI12.App">

    <UserControl.Resources>

        <!-- Une mesure suivie : la courbe donne la forme, les trois chiffres donnent l'échelle.
             La courbe est tracée dans un repère de 100 × 36 et mise à l'échelle ici par un
             Viewbox : le modèle de vue n'a ainsi aucune dimension de pixel à connaître. -->
        <DataTemplate x:Key="MetricTemplate">
            <Border Style="{StaticResource Card}" Padding="18,15" Margin="0,0,12,12" Width="280">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Muted}"
                               Margin="0,5,0,0" TextWrapping="Wrap" Opacity="0.8" />

                    <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Metric}" Margin="0,10,0,0" />

                    <Viewbox Height="46" Stretch="Fill" Margin="0,8,0,0"
                             HorizontalAlignment="Stretch"
                             Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                        <Canvas Width="100" Height="36">
                            <Polyline Points="{Binding Points}"
                                      Stroke="{DynamicResource Brush.BrandRed}"
                                      StrokeThickness="1.2"
                                      StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Average}" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding Extreme}" Style="{StaticResource Text.Muted}" Margin="14,0,0,0" />
                    </StackPanel>

                    <!-- Une mesure qui manque est expliquée, jamais laissée en courbe plate. -->
                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Muted}"
                               Margin="0,8,0,0" TextWrapping="Wrap" FontStyle="Italic" Opacity="0.85"
                               Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1440" Margin="28,30,28,36">

            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Icon}" Width="20" Height="20"
                      Data="{StaticResource Icon.Pulse}"
                      Stroke="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                <TextBlock Text="Surveillance" Style="{StaticResource Text.Title}" Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Body}" Margin="0,8,0,18"
                       TextWrapping="Wrap" MaxWidth="1000" HorizontalAlignment="Left" />

            <!-- ===== Commande =====
                 Ce que la surveillance peut et ne peut pas est dit avant les boutons : elle ne
                 voit que ce qui se produit pendant qu'elle regarde. -->
            <Border Style="{StaticResource Card}" Padding="20,18" local:Motion.Entrance="True">
                <StackPanel>
                    <TextBlock Text="REGARDER LA MACHINE VIVRE" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,7,0,0" MaxWidth="960"
                               HorizontalAlignment="Left" TextWrapping="Wrap"
                               Text="Le diagnostic décrit la machine à un instant ; la surveillance la regarde dans la durée. C'est ce qui attrape la charge qui monte à l'ouverture d'un logiciel, la température qui grimpe au bout de dix minutes, le programme qui se réveille toutes les trente secondes. Elle ne voit rien de ce qui ne se produit pas pendant qu'elle regarde : faites travailler la machine comme le client la fait travailler." />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource Button.Primary}" Content="Démarrer la surveillance"
                                Command="{Binding StartCommand}" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Arrêter"
                                Command="{Binding StopCommand}" Margin="10,0,0,0" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Consigner dans le journal"
                                Command="{Binding RecordCommand}" Margin="10,0,0,0" />
                        <TextBlock Text="{Binding Elapsed}" Style="{StaticResource Text.Muted}"
                                   VerticalAlignment="Center" Margin="16,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Avant la première mesure : ce qui apparaîtra ici, au lieu d'un grand vide. -->
            <Grid Margin="0,14,0,0" MinHeight="190"
                  Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                <Rectangle RadiusX="14" RadiusY="14" StrokeThickness="1.2" StrokeDashArray="4 4"
                           Stroke="{DynamicResource Brush.BorderStrong}" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <Border Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Center"
                            Background="{DynamicResource Brush.SurfaceHover}">
                        <Path Style="{StaticResource Icon}" Width="20" Height="20" Data="{StaticResource Icon.Pulse}"
                              Stroke="{DynamicResource Brush.TextTertiary}" />
                    </Border>
                    <TextBlock Text="Aucune mesure en cours" Style="{StaticResource Text.Emphasis}"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="520" Margin="0,6,0,0"
                               Text="Processeur, mémoire, température, fréquence et réseau, relevés chaque seconde, avec les programmes qui consomment le plus. Démarrez la surveillance, puis faites travailler la machine." />
                </StackPanel>
            </Grid>

            <!-- ===== Ce que la session permet d'affirmer ===== -->
            <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Body}" Margin="2,22,0,0"
                       FontWeight="SemiBold" TextWrapping="Wrap"
                       Visibility="{Binding HasSamples, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Observations}" Margin="0,12,0,0"
                          Visibility="{Binding HasObservations, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SeverityStripe}" />
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding Statement}" Style="{StaticResource Text.Body}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Muted}"
                                               Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Réserves =====
                 Elles ne sont pas une note de bas de page : un écran sans rien à signaler au bout
                 de deux minutes n'est pas un certificat de bonne santé, et c'est ici que ça se
                 dit. -->
            <Border Style="{StaticResource Card}" Padding="18,15" Margin="0,10,0,0"
                    Visibility="{Binding HasCaveats, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="CE QUE CETTE SURVEILLANCE NE DIT PAS" Style="{StaticResource Text.Eyebrow}" />
                    <ItemsControl ItemsSource="{Binding Caveats}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap" Margin="0,0,0,7" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Mesures suivies ===== -->
            <TextBlock Text="MESURES SUIVIES" Style="{StaticResource Text.Eyebrow}" Margin="2,26,0,12"
                       Visibility="{Binding HasSamples, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource MetricTemplate}"
                          Visibility="{Binding HasSamples, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ===== Processus en tête =====
                 Notre propre processus y figure, marqué : la charge qu'il produit est réelle, et
                 le masquer laisserait chercher des pourcentages introuvables. -->
            <TextBlock Text="AU PREMIER PLAN À L'INSTANT" Style="{StaticResource Text.Eyebrow}" Margin="2,14,0,10"
                       Visibility="{Binding HasSamples, Converter={StaticResource BoolToVisibility}}" />

            <Border Style="{StaticResource Card}" Padding="18,14"
                    Visibility="{Binding HasSamples, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Busiest}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Text.Body}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Load}" Style="{StaticResource Text.Body}"
                                           MinWidth="70" TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{Binding Memory}" Style="{StaticResource Text.Muted}"
                                           MinWidth="100" TextAlignment="Right" Margin="16,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
