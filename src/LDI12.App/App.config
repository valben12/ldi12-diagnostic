<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2" />
  </startup>
  <runtime>
    <!-- WPF ne suit réellement les changements de DPI par écran qu'à partir de .NET Framework
         4.6.2 ET Windows 10 1607, et seulement si ce commutateur reste à false. C'est l'une des
         raisons du choix de 4.6.2 comme plancher. Sans effet sur Windows 7 et 8.1. -->
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false" />
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" />
  </runtime>
</configuration>
