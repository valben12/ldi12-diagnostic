<UserControl x:Class="LDI12.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LDI12.App"
             xmlns:controls="clr-namespace:LDI12.App.Controls"
             xmlns:diag="clr-namespace:LDI12.Core.Diagnostics;assembly=LDI12.Core">

    <UserControl.Resources>
        <!-- L'arc suit la bande du score : vert, ambre, orange, rouge. -->
        <Style x:Key="ScoreArcStyle" TargetType="controls:ScoreArc">
            <Setter Property="TrackBrush" Value="{DynamicResource Brush.TrackBackground}" />
            <Setter Property="ValueBrush" Value="{DynamicResource Brush.StatusGood}" />
            <Setter Property="Thickness" Value="11" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Band}" Value="Attention">
                    <Setter Property="ValueBrush" Value="{DynamicResource Brush.StatusWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Band}" Value="Degraded">
                    <Setter Property="ValueBrush" Value="{DynamicResource Brush.StatusProblem}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Band}" Value="Critical">
                    <Setter Property="ValueBrush" Value="{DynamicResource Brush.StatusCritical}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Le chiffre d'un compteur de constats, à la couleur de sa gravité. -->
        <Style x:Key="SeverityCountText" TargetType="TextBlock" BasedOn="{StaticResource Text.Metric}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:Severity.Critical}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.StatusCritical}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:Severity.Problem}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.StatusProblem}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:Severity.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.StatusWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsZero}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Même règle que les écrans de domaine : la colonne suit la fenêtre jusqu'à 1440 points,
         puis se centre. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1440" Margin="28,30,28,36">

            <!-- ===== Bandeaux d'avertissement, avant toute conclusion ===== -->
            <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,14"
                    Background="{DynamicResource Brush.StatusWarningSoft}"
                    BorderBrush="{DynamicResource Brush.StatusWarning}"
                    Visibility="{Binding HasCompatibilityMessage, Converter={StaticResource BoolToVisibility}}">
                <!-- Une grille et non une pile horizontale : une pile donne à ses enfants une
                     largeur infinie, si bien que le texte se met en page sur 1100 points et se
                     fait couper par le bord de la carte. La colonne étoilée impose la largeur
                     réelle, et le renvoi à la ligne se fait là où il doit. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource Icon.AlertTriangle}"
                          Stroke="{DynamicResource Brush.StatusWarning}" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" Text="{Binding CompatibilityMessage}"
                               Style="{StaticResource Text.Body}"
                               Margin="12,0,0,0" MaxWidth="1100" HorizontalAlignment="Left"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,14"
                    Background="{DynamicResource Brush.StatusInfoSoft}"
                    BorderBrush="{DynamicResource Brush.StatusInfo}"
                    Visibility="{Binding HasElevationMessage, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource Icon.Lock}"
                          Stroke="{DynamicResource Brush.StatusInfo}" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" Text="{Binding ElevationMessage}"
                               Style="{StaticResource Text.Body}"
                               Margin="12,0,0,0" MaxWidth="1100" HorizontalAlignment="Left"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                </Grid>
            </Border>

            <!-- Portée d'une analyse personnalisée : une note obtenue sans avoir tout regardé
                 est le résultat le plus trompeur que ce logiciel puisse produire. -->
            <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,14"
                    Background="{DynamicResource Brush.StatusWarningSoft}"
                    BorderBrush="{DynamicResource Brush.StatusWarning}"
                    Visibility="{Binding HasScopeMessage, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource Icon.Sliders}"
                          Stroke="{DynamicResource Brush.StatusWarning}" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" Text="{Binding ScopeMessage}"
                               Style="{StaticResource Text.Body}"
                               Margin="12,0,0,0" MaxWidth="1100" HorizontalAlignment="Left"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                </Grid>
            </Border>

            <!-- ===== Score ===== -->
            <Border Style="{StaticResource Card}" Padding="26"
                    Visibility="{Binding ShowScore, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Les constats par gravité, en quatre compteurs : la moitié droite du
                         cadre restait vide, et ces chiffres s'y lisent d'un regard. Un compteur
                         à zéro reste en place, éteint. -->
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding SeverityCounts}" VerticalAlignment="Center"
                                  Margin="20,0,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="118" Margin="0,0,8,8" Padding="12,9" CornerRadius="10"
                                        Background="{DynamicResource Brush.SurfaceHover}"
                                        BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource SeverityCountText}" />
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Style="{StaticResource SeverityDot}" Width="7" Height="7" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Text.Muted}"
                                                       Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Brève dilatation à la fin de l'analyse : la ponctuation qui dit « c'est
                         terminé, voici le résultat ». Elle ne se déclenche qu'à la sortie de
                         l'état d'analyse, jamais au démarrage de l'application. -->
                    <Grid Grid.Column="0" Width="156" Height="156" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform />
                        </Grid.RenderTransform>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames
                                                                                   Storyboard.TargetProperty="RenderTransform.ScaleX">
                                                        <EasingDoubleKeyFrame Value="1.05" KeyTime="0:0:0.16" />
                                                        <EasingDoubleKeyFrame Value="1" KeyTime="0:0:0.44">
                                                            <EasingDoubleKeyFrame.EasingFunction>
                                                                <PowerEase EasingMode="EaseOut" Power="3" />
                                                            </EasingDoubleKeyFrame.EasingFunction>
                                                        </EasingDoubleKeyFrame>
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames
                                                                                   Storyboard.TargetProperty="RenderTransform.ScaleY">
                                                        <EasingDoubleKeyFrame Value="1.05" KeyTime="0:0:0.16" />
                                                        <EasingDoubleKeyFrame Value="1" KeyTime="0:0:0.44">
                                                            <EasingDoubleKeyFrame.EasingFunction>
                                                                <PowerEase EasingMode="EaseOut" Power="3" />
                                                            </EasingDoubleKeyFrame.EasingFunction>
                                                        </EasingDoubleKeyFrame>
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <controls:ScoreArc x:Name="Arc" Style="{StaticResource ScoreArcStyle}"
                                           Value="{Binding Score}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Le chiffre est lié à la valeur animée de l'arc, pas au score final :
                                 l'aiguille et le nombre montent ensemble parce qu'ils lisent la
                                 même grandeur. -->
                            <TextBlock Style="{StaticResource Text.Display}" HorizontalAlignment="Center"
                                       Text="{Binding DisplayValue, ElementName=Arc, Converter={StaticResource Rounded}}" />
                            <TextBlock Text="sur 100" Style="{StaticResource Text.Muted}"
                                       HorizontalAlignment="Center" Margin="0,-4,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="30,6,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ÉTAT GÉNÉRAL DE LA MACHINE" Style="{StaticResource Text.Eyebrow}" />
                        <TextBlock Text="{Binding BandLabel}" Style="{StaticResource BandTitle}"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding FindingSummary}" Style="{StaticResource Text.Body}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding CapMessage}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Brush.StatusWarning}" MaxWidth="900" HorizontalAlignment="Left"
                                   Visibility="{Binding HasCapMessage, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Dimensions ===== -->
            <!-- Marge droite négative : chaque carte porte sa gouttière à droite, la dernière
                 colonne s'arrêtait donc dix points avant le bord du cadre du score. -->
            <ItemsControl ItemsSource="{Binding Dimensions}" Margin="0,14,-10,0"
                          Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,10,10"
                                local:Motion.Entrance="True">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBlock Text="{Binding ScoreText}" HorizontalAlignment="Right"
                                               Style="{StaticResource BandMetric}" />
                                </Grid>
                                <ProgressBar Style="{StaticResource BandBar}"
                                             Value="{Binding Score, Mode=OneWay}"
                                             Margin="0,10,0,0" />
                                <TextBlock Text="{Binding Coverage}" Style="{StaticResource Text.Muted}"
                                           Margin="0,9,0,0" />
                                <TextBlock Text="{Binding CapApplied}" Style="{StaticResource Text.Muted}"
                                           Margin="0,4,0,0" Foreground="{DynamicResource Brush.StatusWarning}"
                                           Visibility="{Binding HasCap, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Conclusions ===== -->
            <TextBlock Text="CONCLUSIONS" Style="{StaticResource Text.Eyebrow}" Margin="2,10,0,10"
                       Visibility="{Binding Correlations.Count, Converter={StaticResource CountToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Correlations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="0"
                                local:Motion.Entrance="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SeverityStripe}"
                                        Margin="15,18,0,18" />
                                <StackPanel Grid.Column="1" Margin="14,18,20,18">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Emphasis}" />
                                    <TextBlock Text="{Binding Narrative}" Style="{StaticResource Text.Body}"
                                               Margin="0,8,0,0" MaxWidth="1100" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Plan d'action ===== -->
            <TextBlock Text="À TRAITER EN PRIORITÉ" Style="{StaticResource Text.Eyebrow}" Margin="2,10,0,10"
                       Visibility="{Binding Priorities.Count, Converter={StaticResource CountToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Priorities}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18,15" Margin="0,0,0,8"
                                local:Motion.Entrance="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Rank}" Style="{StaticResource Text.Metric}"
                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                           VerticalAlignment="Top" Width="26" />
                                <StackPanel Grid.Column="1" Margin="6,0,16,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Rationale}" Style="{StaticResource Text.Muted}"
                                               Margin="0,5,0,0" MaxWidth="900" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding PriorityLabel}" Style="{StaticResource Text.Muted}"
                                               HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding EffortLabel}" Style="{StaticResource Text.Muted}"
                                               HorizontalAlignment="Right" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Avant la première analyse ===== -->
            <Border Style="{StaticResource Card}" Padding="26"
                    Visibility="{Binding ShowIntro, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Aucune analyse pour l'instant" Style="{StaticResource Text.Emphasis}" />
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" MaxWidth="900" HorizontalAlignment="Left"
                               Text="Une analyse rapide démarre automatiquement à l'ouverture pour donner l'état de la machine en quelques secondes. Le bouton « Diagnostic complet » lance ensuite l'analyse approfondie, qui ajoute les journaux d'événements, les périphériques et les tests réseau." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
